# Copy to .env.local and fill. Local values: run "npx supabase status -o env".

DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Turns on route protection + session validation. Set once auth actions are live.
NEXT_PUBLIC_AUTH_ENABLED=true

# File workspace (enable after setup and worker validation)
FILE_WORKSPACE_ENABLED=false
FILE_WORKER_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
