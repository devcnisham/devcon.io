# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which is meant to be committed and carries no values.
# `.env*` silently swallowed it, which matters more here than in most repos:
# DevCon's own scanner reads `.env.example` and never `.env`, so a repo that
# cannot hold one is a repo DevCon reads nothing from — including this one.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# CodeQL scratch database. 2,983 files of generated artefact — one `git add -A`
# from being committed by accident.
/static_analysis_codeql_1/

# Personal notes and templates that live in the working tree but are not part
# of the app. Deliberately untracked; ignored so they stop showing up in
# `git status` and can't be swept into a commit.
/nisham/
/sumayya/
