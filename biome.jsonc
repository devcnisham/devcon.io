{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",

  // Excludes are listed here rather than inherited from .gitignore. Biome's
  // `vcs.useIgnoreFile` is deprecated in 2.5.7, and dropping it silently pulled
  // the leftover CodeQL database from v0.1 into the lint run — a thousand
  // generated JSON files reported as this project's errors.
  "files": {
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!static_analysis_codeql_1",
      "!nisham",
      "!sumayya"
    ]
  },

  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "javascript": { "formatter": { "quoteStyle": "double" } },

  // Tailwind v4 puts `@theme` and friends in the stylesheet. Without this biome
  // cannot parse globals.css at all — in v0.1 that looked like ~80 unfixable
  // lint errors for weeks.
  "css": { "parser": { "tailwindDirectives": true } },

  "overrides": [
    {
      // `!important` is the point here: a reduced-motion floor that any
      // component can out-specify is not a floor.
      "includes": ["app/globals.css"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
    }
  ]
}
